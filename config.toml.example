# VERA20k configuration — copy to config.toml and adjust paths.
# config.toml is gitignored because it contains machine-specific paths.

[paths]
# Point this to your Red Alert 2: Yuri's Revenge installation directory.
# The engine reads .mix files directly from here (ra2.mix, language.mix, etc.)
ra2_dir = "C:/Westwood/RA2"

[graphics]
width = 1024
height = 768
vsync = true
extra_animations = true   # cosmetic effects: water/ore sparkles (future: laser pulses, particle trails)


[gameplay]
sim_tick_hz = 15
input_delay_ticks = 2

# Optional: let an external compatible API control computer houses in a
# single-player skirmish. Enabling this sends that house's observation (visible
# enemies only) to the configured endpoint. Put credentials in the local
# VERA20K_AI_API_KEY environment variable, never in config.toml.
#
# [external_ai]
# enabled = false
# endpoint = "https://api.openai.com/v1/chat/completions"
# model = "your-model-name"
# request_interval_frames = 225
# request_timeout_secs = 15
# max_actions_per_response = 16
# control_lease_frames = 450
